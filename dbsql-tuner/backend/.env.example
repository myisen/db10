# DBSQL-Tuner — Backend Example Environment
# Copy to .env before running locally.

# App
APP_NAME=DBSQL-Tuner
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Metadata DB. SQLite (dev default) or PostgreSQL (prod).
# SQLite example:
DATABASE_URL=sqlite+aiosqlite:///./dbsql_tuner.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://tuner:tuner@localhost:5432/dbsql_tuner

# Oracle Thick mode. Leave empty to let oracledb search system paths.
ORACLE_CLIENT_LIB_DIR=

# Oracle pool sizing
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20
ORACLE_POOL_INCREMENT=1

# 32-byte url-safe base64 key for encrypting Oracle passwords.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=please-change-me-in-production

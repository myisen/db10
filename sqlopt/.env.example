# SQLOpt 配置示例，复制为 .env 使用
DATABASE_URL=sqlite:///./sqlopt.db
# 生产切 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://sqlopt:pwd@host:5432/sqlopt

# Fernet 密钥（32字节 base64），用于加密目标实例密码
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_ME_WITH_A_REAL_KEY

# API 监听地址
API_HOST=0.0.0.0
API_PORT=8000

# 在线执行安全配置
EXEC_TIMEOUT_SECONDS=30
EXEC_MAX_ROWS=1000
EXEC_HARD_TIMEOUT_SECONDS=300
